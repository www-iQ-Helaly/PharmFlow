---
interface Props {
  kicker?: string;
  title: string;
  lead?: string;
  align?: 'center' | 'start';
}
const { kicker, title, lead, align = 'center' } = Astro.props;
---

<div class={align === 'center' ? 'text-center' : 'text-start'}>
  {kicker && <p class="text-sm font-bold text-primary-600">{kicker}</p>}
  <h2 class="mt-2 font-heading text-3xl font-extrabold text-slate-900 sm:text-4xl">{title}</h2>
  {lead && <p class={`mt-4 leading-relaxed text-slate-600 ${align === 'center' ? 'mx-auto max-w-2xl' : ''}`}>{lead}</p>}
</div>