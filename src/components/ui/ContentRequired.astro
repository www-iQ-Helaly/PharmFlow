---
import { getTranslations, type Lang } from '../../i18n/translations';

interface Props {
  label?: string;
  note?: string;
  lang?: Lang;
}

const {
  label = 'هذا المحتوى غير متوفر بعد',
  note = 'بانتظار توفير معلومات مؤكدة من فريق المنتج.',
  lang = 'ar',
} = Astro.props;
const t = getTranslations(lang);
---

<div role="note" class="rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 p-8 text-center" aria-label={t.contentRequiredAria}>
  <p class="text-base font-semibold text-slate-600">{label}</p>
  <p class="mt-2 text-sm text-slate-400">{note}</p>
  <span dir="ltr" class="mt-4 inline-block rounded bg-slate-200 px-2.5 py-1 font-mono text-[10px] font-semibold tracking-wide text-slate-600">CONTENT_REQUIRED</span>
</div>