---
export type ButtonVariant = 'primary' | 'secondary' | 'light' | 'outline-light';
interface Props {
  href?: string;
  variant?: ButtonVariant;
  size?: 'md' | 'lg';
  class?: string;
}
const { href = '#', variant = 'primary', size = 'md', class: className = '' } = Astro.props;

const base = 'inline-flex items-center justify-center gap-2 rounded-full font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2';
const variants: Record<ButtonVariant, string> = {
  primary: 'bg-primary-600 text-white hover:bg-primary-700',
  secondary: 'border border-slate-300 bg-white text-slate-800 hover:border-primary-500 hover:text-primary-700',
  light: 'bg-white text-primary-700 hover:bg-primary-50',
  'outline-light': 'border border-white/40 text-white hover:bg-white/10',
};
const sizes = {
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-7 py-3.5 text-base',
};
---

<a href={href} class={`${base} ${variants[variant]} ${sizes[size]} ${className}`}>
  <slot />
</a>