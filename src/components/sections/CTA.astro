---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { getTranslations, type Lang } from '../../i18n/translations';
import downloads from '../../data/downloads.json';
import contact from '../../data/contact.json';
import { promo, whatsappLink } from '../../data/promo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<section id="cta" class="scroll-mt-24 relative overflow-hidden bg-primary-700 py-20 sm:py-24">
  <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-24 h-96 w-96 rounded-full bg-primary-500/30 blur-3xl"></div>
  <div aria-hidden="true" class="pointer-events-none absolute -bottom-24 -left-24 h-96 w-96 rounded-full bg-accent-500/20 blur-3xl"></div>

  <Container class="relative text-center">
    <h2 class="font-heading text-3xl font-extrabold text-white sm:text-4xl">{t.cta.title}</h2>
    <p class="mx-auto mt-4 max-w-xl text-primary-100">{t.cta.lead}</p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <Button href="#intro" variant="light" size="lg">{t.cta.ctaPrimary}</Button>
      <Button href="#video" variant="outline-light" size="lg">
        <Icon name="play" class="h-4 w-4" />
        {t.cta.ctaSecondary}
      </Button>
    </div>

    <div class="mx-auto mt-12 max-w-3xl rounded-2xl border border-white/20 bg-white/10 p-6 text-start">
      <div class="flex items-center justify-center gap-2 text-white">
        <Icon name="download" class="h-5 w-5" />
        <p class="font-semibold">{t.cta.downloadTitle}</p>
      </div>
      <p class="mt-2 text-center text-sm text-primary-100">{t.cta.downloadLead}</p>

      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {[
          { key: 'android', label: t.cta.androidLabel, hint: t.cta.androidHint, item: downloads.android },
          { key: 'windows', label: t.cta.windowsLabel, hint: t.cta.windowsHint, item: downloads.windows },
        ].map(({ label, hint, item }) => (
          <div class="flex flex-col rounded-xl bg-white/10 p-4">
            <a
              href={item.file}
              download
              class="inline-flex items-center justify-center gap-2 rounded-full bg-white px-5 py-3 text-sm font-bold text-primary-700 transition-colors hover:bg-primary-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-primary-700"
            >
              <Icon name="download" class="h-4 w-4" />
              {label}
            </a>
            <p class="mt-3 text-xs leading-relaxed text-primary-100">{hint}</p>
            <p class="mt-2 text-xs text-primary-100">
              {t.cta.sizeLabel}: <span dir="ltr" class="font-semibold text-white">{item.size_mb} MB</span>
            </p>
            <p class="mt-1 text-xs text-primary-100">
              {t.cta.checksumLabel}:
              <span
                dir="ltr"
                class="mt-1 block select-all break-all rounded-md bg-black/20 px-2 py-1 font-mono text-[11px] leading-relaxed text-white"
              >{item.sha256}</span>
            </p>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm text-primary-100">
      <a href={`mailto:${contact.email}`} class="inline-flex items-center gap-2 hover:text-white">
        <Icon name="mail" class="h-4 w-4" />
        {t.cta.email}: <span dir="ltr" class="text-white">{contact.email}</span>
      </a>
      <a
        href={whatsappLink(contact.whatsappUrl, promo[lang].whatsappText)}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full bg-[#25D366] px-4 py-2 font-bold text-slate-950 transition hover:brightness-110"
      >
        <Icon name="message-circle" class="h-4 w-4" />
        {promo[lang].whatsappLabel}: <span dir="ltr">{contact.phoneDisplay}</span>
      </a>
    </div>
    <p class="mt-6 flex items-center justify-center gap-2 text-center text-sm font-semibold text-white">
      <Icon name="building" class="h-4 w-4 text-primary-200" />
      {promo[lang].companyLine}
    </p>
  </Container>
</section>