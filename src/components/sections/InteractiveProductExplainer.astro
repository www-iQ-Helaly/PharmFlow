---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import { getTranslations, type Lang } from '../../i18n/translations';
import type { IconName } from '../../lib/icons';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const tabs = [
  { id: 'overview', label: t.explainer.tabOverview, icon: 'cpu' as IconName },
  { id: 'pos', label: t.explainer.tabPos, icon: 'receipt' as IconName },
  { id: 'inventory', label: t.explainer.tabInventory, icon: 'package' as IconName },
  { id: 'fifo', label: t.explainer.tabFefo, icon: 'calendar' as IconName },
  { id: 'technology', label: t.explainer.tabTechnology, icon: 'shield' as IconName },
  { id: 'workflow', label: t.explainer.tabWorkflow, icon: 'activity' as IconName },
] as const;

const initialTab = 'overview';

const ar = lang === 'ar';
const realNote = ar ? 'لقطة شاشة حقيقية من التطبيق (الإصدار 0.6.0)' : 'Real screenshot from the app (version 0.6.0)';
const screen = {
  pos: { src: '/screenshots/app/pos-cart.png', label: ar ? 'شاشة البيع' : 'Sales screen' },
  inventory: { src: '/screenshots/app/inventory-all.png', label: ar ? 'حالة المخزون' : 'Inventory status' },
  fefo: { src: '/screenshots/app/inventory-expiring.png', label: ar ? 'تنبيهات قرب الانتهاء' : 'Near-expiry alerts' },
  technology: { src: '/screenshots/icon_foreground.png', label: 'Official app icon' },
  workflow: { src: '/screenshots/app/receipt-preview.png', label: ar ? 'معاينة الإيصال' : 'Receipt preview' },
};
---

<section id="explainer" class="scroll-mt-24 bg-slate-50 py-20 sm:py-24">
  <Container>
    <div data-reveal>
      <SectionHeading
        kicker={t.explainer.kicker}
        title={t.explainer.title}
        lead={t.explainer.lead}
        align="start"
      />
    </div>

    <!-- Tab Navigation -->
    <div class="mt-10 flex flex-wrap gap-2 border-b border-slate-200 pb-2" data-reveal>
      {tabs.map((tab) => (
        <button
          type="button"
          class="tab-btn flex items-center gap-2 rounded-t-lg border-b-2 border-transparent bg-transparent px-4 py-2.5 text-sm font-medium text-slate-500 transition-all hover:bg-slate-100 hover:text-slate-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2"
          data-tab={tab.id}
          aria-selected={tab.id === initialTab}
          aria-controls={`tab-panel-${tab.id}`}
          tabindex={tab.id === initialTab ? 0 : -1}
        >
          <Icon name={tab.icon} class="h-4 w-4" />
          {tab.label}
        </button>
      ))}
    </div>

    <!-- Tab Panels -->
    <div class="mt-8 grid gap-8 lg:grid-cols-2 lg:gap-12">
      <!-- Overview -->
      <div
        id="tab-panel-overview"
        role="tabpanel"
        aria-labelledby="tab-btn-overview"
        class="tab-panel rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"
        data-tab-panel="overview"
      >
        <div class="flex items-center gap-3 mb-4">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary-100 text-primary-700">
            <Icon name="cpu" class="h-6 w-6" />
          </div>
          <div>
            <h3 class="font-heading text-xl font-bold text-slate-900">{t.explainer.overview.title}</h3>
            <p class="text-sm font-medium text-primary-600">{t.explainer.overview.subtitle}</p>
          </div>
        </div>

        <div class="space-y-4">
          <p class="leading-relaxed text-slate-600">{t.explainer.overview.description}</p>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-xl border border-slate-100 bg-slate-50/60 p-4">
              <div class="flex items-center gap-2 mb-2">
                <Icon name="package" class="h-5 w-5 text-primary-600" />
                <span class="font-semibold text-slate-800">{t.explainer.overview.cardProducts.title}</span>
              </div>
              <p class="text-sm text-slate-600">{t.explainer.overview.cardProducts.content}</p>
            </div>
            <div class="rounded-xl border border-slate-100 bg-slate-50/60 p-4">
              <div class="flex items-center gap-2 mb-2">
                <Icon name="calendar" class="h-5 w-5 text-primary-600" />
                <span class="font-semibold text-slate-800">{t.explainer.overview.cardBatches.title}</span>
              </div>
              <p class="text-sm text-slate-600">{t.explainer.overview.cardBatches.content}</p>
            </div>
            <div class="rounded-xl border border-slate-100 bg-slate-50/60 p-4">
              <div class="flex items-center gap-2 mb-2">
                <Icon name="receipt" class="h-5 w-5 text-primary-600" />
                <span class="font-semibold text-slate-800">{t.explainer.overview.cardInvoices.title}</span>
              </div>
              <p class="text-sm text-slate-600">{t.explainer.overview.cardInvoices.content}</p>
            </div>
            <div class="rounded-xl border border-slate-100 bg-slate-50/60 p-4">
              <div class="flex items-center gap-2 mb-2">
                <Icon name="users" class="h-5 w-5 text-primary-600" />
                <span class="font-semibold text-slate-800">{t.explainer.overview.cardBranches.title}</span>
              </div>
              <p class="text-sm text-slate-600">{t.explainer.overview.cardBranches.content}</p>
            </div>
          </div>

          <div class="rounded-xl border border-primary-200 bg-primary-50/50 p-4">
            <div class="flex items-start gap-3">
              <Icon name="shield" class="h-6 w-6 text-primary-600 mt-0.5 shrink-0" />
              <div>
                <p class="font-semibold text-slate-800">{t.explainer.overview.securityNote.title}</p>
                <p class="text-sm text-slate-600 mt-1">{t.explainer.overview.securityNote.content}</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- POS -->
      <div
        id="tab-panel-pos"
        role="tabpanel"
        aria-labelledby="tab-btn-pos"
        class="tab-panel rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hidden lg:grid-cols-2 lg:items-start"
        data-tab-panel="pos"
      >
        <div class="lg:col-span-1">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary-100 text-primary-700">
              <Icon name="receipt" class="h-6 w-6" />
            </div>
            <div>
              <h3 class="font-heading text-xl font-bold text-slate-900">{t.explainer.pos.title}</h3>
              <p class="text-sm font-medium text-primary-600">{t.explainer.pos.subtitle}</p>
            </div>
          </div>

          <div class="space-y-4">
            <p class="leading-relaxed text-slate-600">{t.explainer.pos.description}</p>

            <div class="space-y-3">
              <h4 class="font-semibold text-slate-800">{t.explainer.pos.scanning.title}</h4>
              <ul class="space-y-2 pl-4">
                <li class="flex items-start gap-2 text-sm text-slate-600">
                  <Icon name="check" class="h-4 w-4 text-primary-600 mt-0.5 shrink-0" />
                  {t.explainer.pos.scanning.item1}
                </li>
                <li class="flex items-start gap-2 text-sm text-slate-600">
                  <Icon name="check" class="h-4 w-4 text-primary-600 mt-0.5 shrink-0" />
                  {t.explainer.pos.scanning.item2}
                </li>
                <li class="flex items-start gap-2 text-sm text-slate-600">
                  <Icon name="check" class="h-4 w-4 text-primary-600 mt-0.5 shrink-0" />
                  {t.explainer.pos.scanning.item3}
                </li>
              </ul>
            </div>

            <div class="space-y-3">
              <h4 class="font-semibold text-slate-800">{t.explainer.pos.cart.title}</h4>
              <ul class="space-y-2 pl-4">
                <li class="flex items-start gap-2 text-sm text-slate-600">
                  <Icon name="check" class="h-4 w-4 text-primary-600 mt-0.5 shrink-0" />
                  {t.explainer.pos.cart.item1}
                </li>
                <li class="flex items-start gap-2 text-sm text-slate-600">
                  <Icon name="check" class="h-4 w-4 text-primary-600 mt-0.5 shrink-0" />
                  {t.explainer.pos.cart.item2}
                </li>
                <li class="flex items-start gap-2 text-sm text-slate-600">
                  <Icon name="check" class="h-4 w-4 text-primary-600 mt-0.5 shrink-0" />
                  {t.explainer.pos.cart.item3}
                </li>
                <li class="flex items-start gap-2 text-sm text-slate-600">
                  <Icon name="check" class="h-4 w-4 text-primary-600 mt-0.5 shrink-0" />
                  {t.explainer.pos.cart.item4}
                </li>
              </ul>
            </div>

            <div class="space-y-3">
              <h4 class="font-semibold text-slate-800">{t.explainer.pos.engine.title}</h4>
              <ul class="space-y-2 pl-4">
                <li class="flex items-start gap-2 text-sm text-slate-600">
                  <Icon name="check" class="h-4 w-4 text-primary-600 mt-0.5 shrink-0" />
                  {t.explainer.pos.engine.item1}
                </li>
                <li class="flex items-start gap-2 text-sm text-slate-600">
                  <Icon name="check" class="h-4 w-4 text-primary-600 mt-0.5 shrink-0" />
                  {t.explainer.pos.engine.item2}
                </li>
                <li class="flex items-start gap-2 text-sm text-slate-600">
                  <Icon name="check" class="h-4 w-4 text-primary-600 mt-0.5 shrink-0" />
                  {t.explainer.pos.engine.item3}
                </li>
              </ul>
            </div>

            <div class="rounded-xl border border-slate-100 bg-slate-50/60 p-4">
              <div class="flex items-start gap-3">
                <Icon name="activity" class="h-5 w-5 text-primary-600 mt-0.5 shrink-0" />
                <div>
                  <p class="font-semibold text-slate-800 text-sm">{t.explainer.pos.suspended.title}</p>
                  <p class="text-sm text-slate-600 mt-1">{t.explainer.pos.suspended.content}</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-6 lg:mt-0 lg:col-span-1">
          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 shadow-inner">
            <img src={screen.pos.src} alt={screen.pos.label} class="mx-auto max-h-[36rem] w-auto" loading="lazy" />
          </div>
          <!-- provenance badge -->
          <p class="mt-2 text-center text-xs text-slate-500">{screen.pos.label} — {realNote}</p>
        </div>
      </div>

      <!-- Inventory -->
      <div
        id="tab-panel-inventory"
        role="tabpanel"
        aria-labelledby="tab-btn-inventory"
        class="tab-panel rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hidden lg:grid-cols-2 lg:items-start"
        data-tab-panel="inventory"
      >
        <div class="lg:col-span-1">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary-100 text-primary-700">
              <Icon name="package" class="h-6 w-6" />
            </div>
            <div>
              <h3 class="font-heading text-xl font-bold text-slate-900">{t.explainer.inventory.title}</h3>
              <p class="text-sm font-medium text-primary-600">{t.explainer.inventory.subtitle}</p>
            </div>
          </div>

          <div class="space-y-4">
            <p class="leading-relaxed text-slate-600">{t.explainer.inventory.description}</p>

            <div class="grid gap-4 sm:grid-cols-2">
              <div class="rounded-xl border border-slate-100 bg-slate-50/60 p-4">
                <div class="flex items-center gap-2 mb-2">
                  <Icon name="package" class="h-5 w-5 text-primary-600" />
                  <span class="font-semibold text-slate-800">{t.explainer.inventory.cardStock.title}</span>
                </div>
                <p class="text-sm text-slate-600">{t.explainer.inventory.cardStock.content}</p>
              </div>
              <div class="rounded-xl border border-slate-100 bg-slate-50/60 p-4">
                <div class="flex items-center gap-2 mb-2">
                  <Icon name="check" class="h-5 w-5 text-primary-600" />
                  <span class="font-semibold text-slate-800">{t.explainer.inventory.cardReconciliation.title}</span>
                </div>
                <p class="text-sm text-slate-600">{t.explainer.inventory.cardReconciliation.content}</p>
              </div>
            </div>

            <div class="space-y-3">
              <h4 class="font-semibold text-slate-800">{t.explainer.inventory.exports.title}</h4>
              <div class="flex flex-wrap gap-2">
                {t.explainer.inventory.exports.formats.map((format) => (
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1.5 text-sm font-medium text-slate-700">
                    <Icon name="download" class="h-3.5 w-3.5 text-primary-600" />
                    {format}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div class="mt-6 lg:mt-0 lg:col-span-1">
          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 shadow-inner">
            <img src={screen.inventory.src} alt={screen.inventory.label} class="mx-auto max-h-[36rem] w-auto" loading="lazy" />
          </div>
          <p class="mt-2 text-center text-xs text-slate-500">{screen.inventory.label} — {realNote}</p>
        </div>
      </div>

      <!-- FEFO / Expiry -->
      <div
        id="tab-panel-fifo"
        role="tabpanel"
        aria-labelledby="tab-btn-fifo"
        class="tab-panel rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hidden lg:grid-cols-2 lg:items-start"
        data-tab-panel="fifo"
      >
        <div class="lg:col-span-1">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary-100 text-primary-700">
              <Icon name="calendar" class="h-6 w-6" />
            </div>
            <div>
              <h3 class="font-heading text-xl font-bold text-slate-900">{t.explainer.fefo.title}</h3>
              <p class="text-sm font-medium text-primary-600">{t.explainer.fefo.subtitle}</p>
            </div>
          </div>

          <div class="space-y-4">
            <p class="leading-relaxed text-slate-600">{t.explainer.fefo.description}</p>

            <div class="rounded-xl border border-primary-200 bg-primary-50/50 p-4">
              <p class="font-semibold text-slate-800">{t.explainer.fefo.principle}</p>
            </div>

            <div class="grid gap-4 sm:grid-cols-3">
              <div class="rounded-xl border border-slate-100 bg-slate-50/60 p-4 text-center">
                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-green-100 text-green-700 mx-auto mb-2">
                  <span class="text-lg font-bold">1</span>
                </div>
                <h4 class="font-semibold text-slate-800 text-sm">{t.explainer.fefo.steps.add}</h4>
                <p class="text-xs text-slate-600 mt-1">{t.explainer.fefo.steps.addDesc}</p>
              </div>
              <div class="rounded-xl border border-slate-100 bg-slate-50/60 p-4 text-center">
                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary-100 text-primary-700 mx-auto mb-2">
                  <span class="text-lg font-bold">2</span>
                </div>
                <h4 class="font-semibold text-slate-800 text-sm">{t.explainer.fefo.steps.allocate}</h4>
                <p class="text-xs text-slate-600 mt-1">{t.explainer.fefo.steps.allocateDesc}</p>
              </div>
              <div class="rounded-xl border border-slate-100 bg-slate-50/60 p-4 text-center">
                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-amber-100 text-amber-700 mx-auto mb-2">
                  <span class="text-lg font-bold">3</span>
                </div>
                <h4 class="font-semibold text-slate-800 text-sm">{t.explainer.fefo.steps.validate}</h4>
                <p class="text-xs text-slate-600 mt-1">{t.explainer.fefo.steps.validateDesc}</p>
              </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-3">
              <div class="rounded-xl border border-green-200 bg-green-50/50 p-4 text-center">
                <div class="text-2xl mb-1">🟢</div>
                <p class="font-semibold text-green-800 text-sm">{t.explainer.fefo.alerts.healthy}</p>
                <p class="text-xs text-green-700 mt-1">{t.explainer.fefo.alerts.healthyDesc}</p>
              </div>
              <div class="rounded-xl border border-amber-200 bg-amber-50/50 p-4 text-center">
                <div class="text-2xl mb-1">🟡</div>
                <p class="font-semibold text-amber-800 text-sm">{t.explainer.fefo.alerts.warning}</p>
                <p class="text-xs text-amber-700 mt-1">{t.explainer.fefo.alerts.warningDesc}</p>
              </div>
              <div class="rounded-xl border border-red-200 bg-red-50/50 p-4 text-center">
                <div class="text-2xl mb-1">🔴</div>
                <p class="font-semibold text-red-800 text-sm">{t.explainer.fefo.alerts.blocked}</p>
                <p class="text-xs text-red-700 mt-1">{t.explainer.fefo.alerts.blockedDesc}</p>
              </div>
            </div>

            <div class="rounded-xl border border-slate-100 bg-slate-50/60 p-4">
              <div class="flex items-start gap-3">
                <Icon name="check" class="h-5 w-5 text-green-600 mt-0.5 shrink-0" />
                <div>
                  <p class="font-semibold text-slate-800 text-sm">{t.explainer.fefo.test.title}</p>
                  <p class="text-sm text-slate-600 mt-1">{t.explainer.fefo.test.content}</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-6 lg:mt-0 lg:col-span-1">
          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 shadow-inner">
            <img src={screen.fefo.src} alt={screen.fefo.label} class="mx-auto max-h-[36rem] w-auto" loading="lazy" />
          </div>
          <p class="mt-2 text-center text-xs text-slate-500">{screen.fefo.label} — {realNote}</p>
        </div>
      </div>

      <!-- Technology -->
      <div
        id="tab-panel-technology"
        role="tabpanel"
        aria-labelledby="tab-btn-technology"
        class="tab-panel rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hidden lg:grid-cols-2 lg:items-start"
        data-tab-panel="technology"
      >
        <div class="lg:col-span-1">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary-100 text-primary-700">
              <Icon name="shield" class="h-6 w-6" />
            </div>
            <div>
              <h3 class="font-heading text-xl font-bold text-slate-900">{t.explainer.technology.title}</h3>
              <p class="text-sm font-medium text-primary-600">{t.explainer.technology.subtitle}</p>
            </div>
          </div>

          <div class="space-y-4">
            <p class="leading-relaxed text-slate-600">{t.explainer.technology.description}</p>

            <div class="grid gap-4 sm:grid-cols-2">
              <div class="rounded-xl border border-slate-100 bg-slate-50/60 p-4">
                <div class="flex items-center gap-2 mb-3">
                  <Icon name="lock" class="h-5 w-5 text-primary-600" />
                  <span class="font-semibold text-slate-800">{t.explainer.technology.cardDatabase.title}</span>
                </div>
                <p class="text-sm text-slate-600 mb-3">{t.explainer.technology.cardDatabase.content}</p>
                <div class="flex flex-wrap gap-2">
                  {t.explainer.technology.cardDatabase.techs.map((tech) => (
                    <span class="inline-flex items-center gap-1 rounded bg-slate-200 px-2 py-1 text-xs font-medium text-slate-700">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>

              <div class="rounded-xl border border-slate-100 bg-slate-50/60 p-4">
                <div class="flex items-center gap-2 mb-3">
                  <Icon name="lock" class="h-5 w-5 text-primary-600" />
                  <span class="font-semibold text-slate-800">{t.explainer.technology.cardSecurity.title}</span>
                </div>
                <ul class="space-y-2">
                  {t.explainer.technology.cardSecurity.items.map((item) => (
                    <li class="flex items-start gap-2 text-sm text-slate-600">
                      <Icon name="check" class="h-4 w-4 text-green-600 mt-0.5 shrink-0" />
                      {item}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="rounded-xl border border-slate-100 bg-slate-50/60 p-4">
                <div class="flex items-center gap-2 mb-3">
                  <Icon name="wifi-off" class="h-5 w-5 text-primary-600" />
                  <span class="font-semibold text-slate-800">{t.explainer.technology.cardOffline.title}</span>
                </div>
                <p class="text-sm text-slate-600 mb-3">{t.explainer.technology.cardOffline.content}</p>
                <div class="flex flex-wrap gap-2">
                  {t.explainer.technology.cardOffline.techs.map((tech) => (
                    <span class="inline-flex items-center gap-1 rounded bg-slate-200 px-2 py-1 text-xs font-medium text-slate-700">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>

              <div class="rounded-xl border border-slate-100 bg-slate-50/60 p-4">
                <div class="flex items-center gap-2 mb-3">
                  <Icon name="globe" class="h-5 w-5 text-primary-600" />
                  <span class="font-semibold text-slate-800">{t.explainer.technology.cardLanguages.title}</span>
                </div>
                <p class="text-sm text-slate-600">{t.explainer.technology.cardLanguages.content}</p>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-6 lg:mt-0 lg:col-span-1">
          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 shadow-inner flex items-center justify-center p-6 text-center">
            <div>
              <img src={screen.technology.src} alt={screen.technology.label} class="h-20 w-auto shadow-sm" />
              <p class="mt-3 text-sm font-semibold text-slate-700">{t.explainer.technology.title}</p>
              <p class="text-xs text-slate-400">رمز التطبيق الرسمي</p>
            </div>
          </div>
          <span dir="ltr" class="mt-2 inline-block rounded-full bg-primary-100 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-primary-700 ring-1 ring-primary-200">
            {screen.technology.label}
          </span>
          <p class="mt-1 text-xs text-slate-400 text-center">[{t.explainer.tabTechnology}] الأيقونة الرسمية للتطبيق — أصل حقيقي</p>
        </div>
      </div>

      <!-- Workflow -->
      <div
        id="tab-panel-workflow"
        role="tabpanel"
        aria-labelledby="tab-btn-workflow"
        class="tab-panel rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hidden lg:grid-cols-2 lg:items-start"
        data-tab-panel="workflow"
      >
        <div class="lg:col-span-1">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary-100 text-primary-700">
              <Icon name="activity" class="h-6 w-6" />
            </div>
            <div>
              <h3 class="font-heading text-xl font-bold text-slate-900">{t.explainer.workflow.title}</h3>
              <p class="text-sm font-medium text-primary-600">{t.explainer.workflow.subtitle}</p>
            </div>
          </div>

          <div class="space-y-4">
            <p class="leading-relaxed text-slate-600">{t.explainer.workflow.description}</p>

            <ol class="space-y-4">
              {t.explainer.workflow.steps.map((step, index) => (
                <li class="relative rounded-xl border border-slate-100 bg-slate-50/60 p-4">
                  <div class="flex items-start gap-3">
                    <div class="flex h-8 w-8 items-center justify-center rounded-full bg-primary-600 text-white text-sm font-bold shrink-0">
                      {index + 1}
                    </div>
                    <div class="min-w-0 flex-1">
                      <h4 class="font-semibold text-slate-800">{step.title}</h4>
                      <p class="text-sm text-slate-600 mt-1">{step.description}</p>
                      {step.details && (
                        <ul class="mt-2 space-y-1 pl-4">
                          {step.details.map((detail) => (
                            <li class="flex items-start gap-2 text-sm text-slate-600">
                              <Icon name="check" class="h-3.5 w-3.5 text-primary-600 mt-0.5 shrink-0" />
                              {detail}
                            </li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </div>
                </li>
              ))}
            </ol>

            <div class="rounded-xl border border-primary-200 bg-primary-50/50 p-4">
              <div class="flex items-start gap-3">
                <Icon name="shield" class="h-5 w-5 text-primary-600 mt-0.5 shrink-0" />
                <div>
                  <p class="font-semibold text-slate-800 text-sm">{t.explainer.workflow.note.title}</p>
                  <p class="text-sm text-slate-600 mt-1">{t.explainer.workflow.note.content}</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-6 lg:mt-0 lg:col-span-1">
          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 shadow-inner">
            <img src={screen.workflow.src} alt={screen.workflow.label} class="mx-auto max-h-[36rem] w-auto" loading="lazy" />
          </div>
          <p class="mt-2 text-center text-xs text-slate-500">{screen.workflow.label} — {realNote}</p>
        </div>
      </div>
    </div>
  </Container>
</section>

<script>
  document.querySelectorAll('[data-tab]').forEach((button) => {
    button.addEventListener('click', () => {
      const tabId = button.getAttribute('data-tab');

      document.querySelectorAll('[data-tab]').forEach((btn) => {
        btn.setAttribute('aria-selected', 'false');
        btn.classList.remove('bg-white', 'border-primary-600', 'text-primary-700');
        btn.classList.add('border-transparent', 'text-slate-500');
      });

      button.setAttribute('aria-selected', 'true');
      button.classList.remove('border-transparent', 'text-slate-500');
      button.classList.add('border-primary-600', 'text-primary-700', 'bg-white');

      document.querySelectorAll('[data-tab-panel]').forEach((panel) => {
        panel.classList.add('hidden');
      });

      const targetPanel = document.querySelector(`[data-tab-panel="${tabId}"]`);
      if (targetPanel) {
        targetPanel.classList.remove('hidden');
      }
    });
  });

  // Keyboard navigation
  const tabContainer = document.querySelector('[data-tab]')?.parentElement;
  if (tabContainer) {
    tabContainer.addEventListener('keydown', (e: KeyboardEvent) => {
      const tabs = Array.from(tabContainer.querySelectorAll<HTMLButtonElement>('[data-tab]'));
      const currentIndex = tabs.findIndex((t) => t === e.target);

      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        const nextIndex = (currentIndex + 1) % tabs.length;
        tabs[nextIndex].focus();
        tabs[nextIndex].click();
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        const prevIndex = (currentIndex - 1 + tabs.length) % tabs.length;
        tabs[prevIndex].focus();
        tabs[prevIndex].click();
      }
    });
  }
</script>
