---
import { withBase } from '../../lib/paths';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import chapterTimes from '../../data/video-chapters.json';
import { getTranslations, type Lang } from '../../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const times = chapterTimes as Record<string, number>;
const chapters = t.video.chapters.filter((c) => times[c.id] !== undefined);
const arabicNote = lang === 'en' ? 'On-screen captions in the video are in Arabic.' : '';
---

<section id="video" class="scroll-mt-24 bg-slate-50 py-20 sm:py-24">
  <Container>
    <div data-reveal>
      <SectionHeading kicker={t.video.kicker} title={t.video.title} lead={t.video.lead} />
    </div>

    <div class="mt-14 grid items-start gap-10 lg:grid-cols-[auto_1fr] lg:gap-16" data-reveal>
      <div class="mx-auto w-full max-w-[17.5rem]">
        <div class="overflow-hidden rounded-[2rem] border-4 border-slate-800 bg-slate-900 shadow-xl">
          <video
            id="intro-video"
            class="block h-auto w-full"
            controls
            playsinline
            preload="metadata"
            poster={withBase('/assets/video/pharmflow-intro-poster.jpg')}
          >
            <source src={withBase('/assets/video/pharmflow-intro.mp4')} type="video/mp4" />
          </video>
        </div>
        {arabicNote && <p class="mt-3 text-center text-xs text-slate-400">{arabicNote}</p>}
      </div>

      <div>
        <h3 class="font-heading text-lg font-bold text-slate-900">{t.video.chaptersTitle}</h3>
        <ol class="mt-4 space-y-2">
          {chapters.map((c) => (
            <li>
              <button
                type="button"
                data-seek={times[c.id]}
                class="flex w-full items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 text-start text-sm font-medium text-slate-700 transition-colors hover:border-primary-300 hover:text-primary-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500"
              >
                <Icon name="play" class="h-4 w-4 shrink-0 text-primary-600" />
                <span class="flex-1">{c.label}</span>
                <span dir="ltr" class="font-mono text-xs text-slate-400">
                  {Math.floor(times[c.id] / 60)}:{String(Math.floor(times[c.id] % 60)).padStart(2, '0')}
                </span>
              </button>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <div class="mt-16" data-reveal>
      <h3 class="font-heading text-xl font-bold text-slate-900">{t.video.featuresTitle}</h3>
      <ul class="mt-6 grid gap-6 sm:grid-cols-2">
        {t.video.features.map((f) => (
          <li class="rounded-2xl border border-slate-200 bg-white p-6">
            <div class="flex items-center gap-3">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary-100 text-primary-700">
                <Icon name={f.icon} class="h-5 w-5" />
              </span>
              <h4 class="font-heading text-lg font-bold text-slate-900">{f.title}</h4>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-slate-600">{f.text}</p>
            {f.note && <p class="mt-3 text-xs text-slate-400">{f.note}</p>}
          </li>
        ))}
      </ul>
    </div>
  </Container>
</section>

<script>
  const video = document.getElementById('intro-video') as HTMLVideoElement | null;
  document.querySelectorAll<HTMLButtonElement>('[data-seek]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!video) return;
      video.currentTime = Number(button.dataset.seek);
      void video.play();
    });
  });
</script>
