# PharmFlow static site — nginx server block.
# Replace YOUR_DOMAIN and (if different) the root path, then save as
# /etc/nginx/sites-available/pharmflow and symlink into sites-enabled.

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN www.YOUR_DOMAIN;

    root /var/www/pharmflow;
    index index.html;

    charset utf-8;

    # Pages: /, /en/, /docs/, /slides/ resolve to their index.html
    location / {
        try_files $uri $uri/ =404;
    }

    # Hashed build assets can be cached for a long time
    location /_astro/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Installers: served as downloads, supports resuming
    location /downloads/ {
        add_header Cache-Control "public, max-age=3600";
        add_header Content-Disposition "attachment";
        try_files $uri =404;
    }

    # Screenshots, videos, fonts, icons
    location ~* \.(png|jpg|jpeg|webp|svg|ico|mp4|woff2?)$ {
        add_header Cache-Control "public, max-age=2592000";
        try_files $uri =404;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
}

# HTTPS: run `sudo certbot --nginx -d YOUR_DOMAIN -d www.YOUR_DOMAIN`
# after the block above is live; certbot rewrites it to add the 443 server and
# the HTTP->HTTPS redirect automatically.
